        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
      </collision>
      <visual name="red_tunnel_east_wall_visual">
        <pose>-2.55 -5.5 0.125 0 0 0</pose>
        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
        <material><ambient>0.30 0.10 0.10 1</ambient><diffuse>0.30 0.10 0.10 1</diffuse></material>
      </visual>
      <collision name="red_road_15_ramp_collision">
        <pose>-6.060 -5.5 0.126 0 -0.261799 0</pose>
        <geometry><box><size>1.159 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="red_road_15_ramp_visual">
        <pose>-6.060 -5.5 0.126 0 -0.261799 0</pose>
        <geometry><box><size>1.159 1.80 0.05</size></box></geometry>
        <material><ambient>0.55 0.16 0.12 1</ambient><diffuse>0.55 0.16 0.12 1</diffuse></material>
      </visual>
      <collision name="red_road_11_ramp_collision">
        <pose>0.272 -5.5 0.125 0 0.191986 0</pose>
        <geometry><box><size>1.572 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="red_road_11_ramp_visual">
        <pose>0.272 -5.5 0.125 0 0.191986 0</pose>
        <geometry><box><size>1.572 1.80 0.05</size></box></geometry>
        <material><ambient>0.62 0.22 0.16 1</ambient><diffuse>0.62 0.22 0.16 1</diffuse></material>
      </visual>

      <!-- Blue road, center-symmetric counterpart. -->
      <collision name="blue_road_roof_collision">
        <pose>3.0 5.5 0.275 0 0 0</pose>
        <geometry><box><size>5.00 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="blue_road_roof_visual">
