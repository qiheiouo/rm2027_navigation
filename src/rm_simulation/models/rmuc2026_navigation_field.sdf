        <geometry><box><size>1.924 6.00 0.05</size></box></geometry>
        <material><ambient>0.34 0.34 0.36 1</ambient><diffuse>0.34 0.34 0.36 1</diffuse></material>
      </visual>

      <!-- Red road: 0.25 m tunnel clearance, 0.30 m driving surface. -->
      <collision name="red_road_roof_collision">
        <pose>-3.0 -5.5 0.275 0 0 0</pose>
        <geometry><box><size>5.00 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="red_road_roof_visual">
        <pose>-3.0 -5.5 0.275 0 0 0</pose>
        <geometry><box><size>5.00 1.80 0.05</size></box></geometry>
        <material><ambient>0.36 0.12 0.12 1</ambient><diffuse>0.36 0.12 0.12 1</diffuse></material>
