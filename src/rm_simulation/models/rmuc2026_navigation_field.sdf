      </visual>
      <collision name="blue_tunnel_west_wall_collision">
        <pose>2.55 5.5 0.125 0 0 0</pose>
        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
      </collision>
      <visual name="blue_tunnel_west_wall_visual">
        <pose>2.55 5.5 0.125 0 0 0</pose>
        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
        <material><ambient>0.08 0.14 0.36 1</ambient><diffuse>0.08 0.14 0.36 1</diffuse></material>
      </visual>
      <collision name="blue_tunnel_east_wall_collision">
        <pose>3.45 5.5 0.125 0 0 0</pose>
        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
      </collision>
      <visual name="blue_tunnel_east_wall_visual">
        <pose>3.45 5.5 0.125 0 0 0</pose>
        <geometry><box><size>0.10 1.80 0.25</size></box></geometry>
        <material><ambient>0.08 0.14 0.36 1</ambient><diffuse>0.08 0.14 0.36 1</diffuse></material>
      </visual>
      <collision name="blue_road_11_ramp_collision">
        <pose>-0.272 5.5 0.125 0 -0.191986 0</pose>
        <geometry><box><size>1.572 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="blue_road_11_ramp_visual">
        <pose>-0.272 5.5 0.125 0 -0.191986 0</pose>
        <geometry><box><size>1.572 1.80 0.05</size></box></geometry>
        <material><ambient>0.14 0.30 0.68 1</ambient><diffuse>0.14 0.30 0.68 1</diffuse></material>
      </visual>
      <collision name="blue_road_15_ramp_collision">
        <pose>6.060 5.5 0.126 0 0.261799 0</pose>
        <geometry><box><size>1.159 1.80 0.05</size></box></geometry>
      </collision>
      <visual name="blue_road_15_ramp_visual">
        <pose>6.060 5.5 0.126 0 0.261799 0</pose>
        <geometry><box><size>1.159 1.80 0.05</size></box></geometry>
        <material><ambient>0.12 0.38 0.76 1</ambient><diffuse>0.12 0.38 0.76 1</diffuse></material>
      </visual>

      <!-- Representative non-traversable major field modules. -->
      <collision name="red_base_collision">
        <pose>-10.5 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>1.05</radius><length>0.60</length></cylinder></geometry>
      </collision>
      <visual name="red_base_visual">
        <pose>-10.5 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>1.05</radius><length>0.60</length></cylinder></geometry>
        <material><ambient>0.45 0.08 0.08 1</ambient><diffuse>0.45 0.08 0.08 1</diffuse></material>
      </visual>
      <collision name="blue_base_collision">
        <pose>10.5 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>1.05</radius><length>0.60</length></cylinder></geometry>
      </collision>
      <visual name="blue_base_visual">
        <pose>10.5 0 0.30 0 0 0</pose>
        <geometry><cylinder><radius>1.05</radius><length>0.60</length></cylinder></geometry>
        <material><ambient>0.06 0.15 0.48 1</ambient><diffuse>0.06 0.15 0.48 1</diffuse></material>
      </visual>
      <collision name="red_trapezoid_highland_collision">
        <pose>-8.0 4.2 0.20 0 0 -0.20</pose>
        <geometry><box><size>3.6 2.5 0.40</size></box></geometry>
      </collision>
      <visual name="red_trapezoid_highland_visual">
        <pose>-8.0 4.2 0.20 0 0 -0.20</pose>
        <geometry><box><size>3.6 2.5 0.40</size></box></geometry>
        <material><ambient>0.32 0.10 0.10 1</ambient><diffuse>0.32 0.10 0.10 1</diffuse></material>
      </visual>
      <collision name="blue_trapezoid_highland_collision">
        <pose>8.0 -4.2 0.20 0 0 -0.20</pose>
        <geometry><box><size>3.6 2.5 0.40</size></box></geometry>
      </collision>
      <visual name="blue_trapezoid_highland_visual">
        <pose>8.0 -4.2 0.20 0 0 -0.20</pose>
        <geometry><box><size>3.6 2.5 0.40</size></box></geometry>
        <material><ambient>0.08 0.14 0.34 1</ambient><diffuse>0.08 0.14 0.34 1</diffuse></material>
      </visual>

      <!-- 17 degree fly ramps are visible/collidable but not costmap-filtered. -->
      <collision name="red_fly_ramp_collision">
        <pose>-6.0 -2.7 0.076 0 -0.296706 0</pose>
        <geometry><box><size>0.680 1.145 0.05</size></box></geometry>
      </collision>
      <visual name="red_fly_ramp_visual">
        <pose>-6.0 -2.7 0.076 0 -0.296706 0</pose>
