<?xml version="1.0"?>
<sdf version="1.7">
  <!--
    Navigation-grade RMUC 2026 field approximation.

    Sources:
      - RMUC 2026 rules V2.2.0, figures 4-4 through 4-6, 4-28,
        and 4-35 through 4-38.
      - The official 00_RMUC2026_FINALS_ASM STEP is retained as a future
        geometry audit source, but is intentionally not loaded at runtime.

    Scope:
      - 28 m x 15 m boundary;
      - symmetric road decks with 11/15 degree approaches and 0.80 m x
        0.25 m tunnel openings;
      - 10.5 degree central-highland approaches;
      - representative bases, trapezoid highlands and 17 degree fly ramps.

    Small hardware, artwork, electronics, fans, mechanisms and exact wall
    contours are deliberately omitted. This model is not a manufacturing
    drawing and must be re-audited against accepted field CAD before release.
  -->
  <model name="rmuc2026_navigation_field">
    <static>true</static>
    <link name="field_link">
      <!-- 28 m x 15 m outer boundary. The 2.4 m height follows rule 4.1. -->
      <collision name="north_wall_collision">
        <pose>0 7.55 1.20 0 0 0</pose>
        <geometry><box><size>28.20 0.10 2.40</size></box></geometry>
      </collision>
      <visual name="north_wall_visual">
        <pose>0 7.55 1.20 0 0 0</pose>
        <geometry><box><size>28.20 0.10 2.40</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="south_wall_collision">
        <pose>0 -7.55 1.20 0 0 0</pose>
        <geometry><box><size>28.20 0.10 2.40</size></box></geometry>
      </collision>
      <visual name="south_wall_visual">
        <pose>0 -7.55 1.20 0 0 0</pose>
        <geometry><box><size>28.20 0.10 2.40</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="west_wall_collision">
        <pose>-14.05 0 1.20 0 0 0</pose>
        <geometry><box><size>0.10 15.00 2.40</size></box></geometry>
      </collision>
      <visual name="west_wall_visual">
        <pose>-14.05 0 1.20 0 0 0</pose>
        <geometry><box><size>0.10 15.00 2.40</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="east_wall_collision">
        <pose>14.05 0 1.20 0 0 0</pose>
        <geometry><box><size>0.10 15.00 2.40</size></box></geometry>
      </collision>
      <visual name="east_wall_visual">
        <pose>14.05 0 1.20 0 0 0</pose>
        <geometry><box><size>0.10 15.00 2.40</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>

      <!-- Central highland: 0.35 m deck and two continuous 10.5 degree ramps. -->
      <collision name="central_deck_collision">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>4.00 6.00 0.35</size></box></geometry>
      </collision>
      <visual name="central_deck_visual">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry><box><size>4.00 6.00 0.35</size></box></geometry>
        <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
      </visual>
      <collision name="central_west_ramp_collision">
        <pose>-2.946 0 0.150 0 -0.183260 0</pose>
        <geometry><box><size>1.924 6.00 0.05</size></box></geometry>
      </collision>
      <visual name="central_west_ramp_visual">
        <pose>-2.946 0 0.150 0 -0.183260 0</pose>
        <geometry><box><size>1.924 6.00 0.05</size></box></geometry>
        <material><ambient>0.34 0.34 0.36 1</ambient><diffuse>0.34 0.34 0.36 1</diffuse></material>
      </visual>
      <collision name="central_east_ramp_collision">
        <pose>2.946 0 0.150 0 0.183260 0</pose>
        <geometry><box><size>1.924 6.00 0.05</size></box></geometry>
      </collision>
