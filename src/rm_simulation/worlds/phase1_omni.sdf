<?xml version="1.0"?>
<!--
  Phase 1.5 placeholder holonomic chassis for Gazebo Fortress.

  The system-plugin structure and directional-friction approach are adapted
  from the Apache-2.0 Gazebo Sim 6.18.0 mecanum-drive example. See
  docs/external/gazebo_fortress_systems.md for the exact upstream reference.

  All mechanical values below are placeholders, not final 2027 robot data.
  This simulation places base_link at the ground-projected chassis rotation
  center. The final 2027 physical base_link origin still requires team
  confirmation and must be changed consistently in URDF, SDF, and extrinsics.
-->
<sdf version="1.7">
  <world name="phase1_omni">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_block">
      <static>true</static>
      <pose>1.4 0 0.4 0 0 0</pose>
      <link name="block_link">
        <collision name="block_collision">
          <geometry>
            <box><size>0.35 1.10 0.80</size></box>
          </geometry>
        </collision>
        <visual name="block_visual">
          <geometry>
            <box><size>0.35 1.10 0.80</size></box>
          </geometry>
          <material>
            <ambient>0.70 0.16 0.12 1</ambient>
            <diffuse>0.70 0.16 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rm_sentry_2027" xmlns:ignition="http://ignitionrobotics.org/schema">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>0 0 0.17 0 0 0</pose>
          <mass>30.0</mass>
          <inertia>
            <ixx>0.706</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.981</iyy>
            <iyz>0</iyz>
            <izz>1.525</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <pose>0 0 0.17 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.50 0.18</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.17 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.50 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.25 0.65 1</ambient>
            <diffuse>0.12 0.25 0.65 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="gimbal_yaw_link">
        <pose relative_to="base_link">0 0 0.35 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0002</iyy><iyz>0</iyz><izz>0.0002</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="gimbal_yaw_joint" type="revolute">
        <parent>base_link</parent>
        <child>gimbal_yaw_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-6.28318530718</lower>
            <upper>6.28318530718</upper>
          </limit>
        </axis>
      </joint>

      <link name="sim_lidar_link">
        <pose relative_to="gimbal_yaw_link">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
          </inertia>
        </inertial>
        <sensor name="phase1_planar_lidar" type="gpu_lidar">
          <topic>/model/rm_sentry_2027/sim_lidar/scan</topic>
          <update_rate>15</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265359</min_angle>
                <max_angle>3.14159265359</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
          <alwaysOn>1</alwaysOn>
          <visualize>false</visualize>
        </sensor>
      </link>

      <joint name="gimbal_yaw_link_to_sim_lidar_link" type="fixed">
        <parent>gimbal_yaw_link</parent>
        <child>sim_lidar_link</child>
      </joint>

      <plugin
        filename="ignition-gazebo-joint-position-controller-system"
        name="ignition::gazebo::systems::JointPositionController">
        <joint_name>gimbal_yaw_joint</joint_name>
        <topic>/model/rm_sentry_2027/gimbal_yaw_cmd</topic>
        <p_gain>20.0</p_gain>
      </plugin>

      <link name="front_left_wheel">
        <pose>0.25 0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="front_right_wheel">
        <pose>0.25 -0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.25 0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_right_wheel">
        <pose>-0.25 -0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <plugin
        filename="ignition-gazebo-mecanum-drive-system"
        name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>0.45</wheel_separation>
        <wheelbase>0.50</wheelbase>
        <wheel_radius>0.075</wheel_radius>
        <min_velocity>-2.0</min_velocity>
        <max_velocity>2.0</max_velocity>
        <min_acceleration>-2.0</min_acceleration>
        <max_acceleration>2.0</max_acceleration>
        <topic>/model/rm_sentry_2027/cmd_vel</topic>
      </plugin>

      <plugin
        filename="ignition-gazebo-odometry-publisher-system"
        name="ignition::gazebo::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/rm_sentry_2027/odometry</odom_topic>
        <tf_topic>/model/rm_sentry_2027/ground_truth_pose</tf_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>2</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
