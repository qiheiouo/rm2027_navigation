<root main_tree_to_execute="CompetitionDefense">
  <BehaviorTree ID="CompetitionDefense">
    <ReactiveFallback name="mission_or_hold">
      <Sequence name="enabled_and_safe">
        <MissionEnabled/>
        <SafetyReady/>
        <ReactiveFallback name="strategy_priority">
          <Sequence name="return_home">
            <ShouldReturnHome/>
            <SelectHome/>
          </Sequence>
          <Sequence name="defensive_patrol">
            <CanPatrol/>
            <SelectPatrol/>
          </Sequence>
          <SelectHold/>
        </ReactiveFallback>
      </Sequence>
      <SelectHold/>
    </ReactiveFallback>
  </BehaviorTree>
</root>
