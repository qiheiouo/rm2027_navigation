<?xml version='1.0' encoding='utf-8'?>
<sdf xmlns:ignition="http://ignitionrobotics.org/schema" version="1.7">
  <world name="phase1_omni">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="rm_sentry_2027">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>0 0 0.17 0 0 0</pose>
          <mass>30.0</mass>
          <inertia>
            <ixx>0.706</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.981</iyy>
            <iyz>0</iyz>
            <izz>1.525</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <pose>0 0 0.17 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.50 0.18</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.17 0 0 0</pose>
          <geometry>
            <box>
              <size>0.60 0.50 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.25 0.65 1</ambient>
            <diffuse>0.12 0.25 0.65 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="sim_lidar_link">
        <pose relative_to="base_link">0 0 0.35 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz>
          </inertia>
        </inertial>
        <sensor name="phase1_planar_lidar" type="gpu_lidar">
          <topic>/model/rm_sentry_2027/sim_lidar/scan</topic>
          <update_rate>15</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265359</min_angle>
                <max_angle>3.14159265359</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
          <alwaysOn>1</alwaysOn>
          <visualize>false</visualize>
        </sensor>
      </link>

      <joint name="base_link_to_sim_lidar_link" type="fixed">
        <parent>base_link</parent>
        <child>sim_lidar_link</child>
      </joint>

      <link name="front_left_wheel">
        <pose>0.25 0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="front_right_wheel">
        <pose>0.25 -0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.25 0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_right_wheel">
        <pose>-0.25 -0.225 0.075 -1.57079632679 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.00225</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00225</iyy><iyz>0</iyz><izz>0.00225</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu><mu2>0.0</mu2>
                <fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.075</radius></sphere></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <plugin filename="ignition-gazebo-mecanum-drive-system" name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>0.45</wheel_separation>
        <wheelbase>0.50</wheelbase>
        <wheel_radius>0.075</wheel_radius>
        <min_velocity>-2.0</min_velocity>
        <max_velocity>2.0</max_velocity>
        <min_acceleration>-2.0</min_acceleration>
        <max_acceleration>2.0</max_acceleration>
        <topic>/model/rm_sentry_2027/cmd_vel</topic>
      </plugin>

      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/rm_sentry_2027/odometry</odom_topic>
        <tf_topic>/model/rm_sentry_2027/ground_truth_pose</tf_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>2</dimensions>
      </plugin>
    <plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>true</publish_link_pose><publish_model_pose>true</publish_model_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>50</update_frequency></plugin></model>
  <model name="moving_obstacle">
    <link name="anchor_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>anchor_link</child>
    </joint>

    <link name="obstacle_link">
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>2.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.0</iyy><iyz>0</iyz><izz>1.0</izz>
        </inertia>
      </inertial>
      <collision name="obstacle_collision">
        <geometry>
          <box><size>.45 1.0 .8</size></box>
        </geometry>
      </collision>
      <visual name="obstacle_visual">
        <geometry>
          <box><size>.45 1.0 .8</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.55 0.08 1</ambient>
          <diffuse>0.85 0.55 0.08 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    <sensor name="actor_contact" type="contact"><update_rate>100</update_rate><contact><collision>obstacle_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link>

    <joint name="slider_joint" type="prismatic">
      <parent>anchor_link</parent>
      <child>obstacle_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.6</lower>
          <upper>1.6</upper>
          <effort>2000</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>8.0</damping>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="ignition-gazebo-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>slider_joint</joint_name>
      <topic>/simulation/moving_obstacle/gz_target</topic>
      <p_gain>180.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>25.0</d_gain>
      <cmd_max>2000.0</cmd_max>
      <cmd_min>-2000.0</cmd_min>
    </plugin>
  <pose>2 0 0 0 0 0</pose><plugin filename="ignition-gazebo-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>true</publish_link_pose><publish_model_pose>true</publish_model_pose><publish_collision_pose>false</publish_collision_pose><publish_visual_pose>false</publish_visual_pose><publish_nested_model_pose>true</publish_nested_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>50</update_frequency></plugin></model>
<plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact" /><model name="corridor_wall_0"><static>true</static><pose>0.15000000000000002 1.15 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_1"><static>true</static><pose>0.15000000000000002 -1.15 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_2"><static>true</static><pose>3.85 1.15 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_3"><static>true</static><pose>3.85 -1.15 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>2.7 0.19999999999999996 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_4"><static>true</static><pose>-1.1 0.0 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.19999999999999996 2.5 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.19999999999999996 2.5 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_5"><static>true</static><pose>5.1 0.0 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.20000000000000018 2.5 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.20000000000000018 2.5 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_6"><static>true</static><pose>1.4 -1.725 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.19999999999999996 0.9500000000000002 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.19999999999999996 0.9500000000000002 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_7"><static>true</static><pose>2.6 -1.725 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.20000000000000018 0.9500000000000002 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.20000000000000018 0.9500000000000002 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_8"><static>true</static><pose>1.4 1.725 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.19999999999999996 0.9500000000000002 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.19999999999999996 0.9500000000000002 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_9"><static>true</static><pose>2.6 1.725 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>0.20000000000000018 0.9500000000000002 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>0.20000000000000018 0.9500000000000002 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_10"><static>true</static><pose>2.0 -2.1 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>1.4000000000000001 0.20000000000000018 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>1.4000000000000001 0.20000000000000018 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model><model name="corridor_wall_11"><static>true</static><pose>2.0 2.1 .5 0 0 0</pose><link name="wall_link"><collision name="wall_collision"><geometry><box><size>1.4000000000000001 0.20000000000000018 1</size></box></geometry></collision><visual name="wall_visual"><geometry><box><size>1.4000000000000001 0.20000000000000018 1</size></box></geometry></visual><sensor name="wall_contact" type="contact"><update_rate>100</update_rate><contact><collision>wall_collision</collision><topic>/simulation/oracle/contacts</topic></contact><always_on>1</always_on></sensor></link></model></world>
</sdf>