<?xml version="1.0"?>
<sdf version="1.7">
  <model name="moving_obstacle">
    <link name="anchor_link">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>anchor_link</child>
    </joint>

    <link name="obstacle_link">
      <pose>0 0 0.4 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>2.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.0</iyy><iyz>0</iyz><izz>1.0</izz>
        </inertia>
      </inertial>
      <collision name="obstacle_collision">
        <geometry>
          <box><size>0.45 0.55 0.8</size></box>
        </geometry>
      </collision>
      <visual name="obstacle_visual">
        <geometry>
          <box><size>0.45 0.55 0.8</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.55 0.08 1</ambient>
          <diffuse>0.85 0.55 0.08 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>

    <joint name="slider_joint" type="prismatic">
      <parent>anchor_link</parent>
      <child>obstacle_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.95</lower>
          <upper>0.95</upper>
          <effort>2000</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>8.0</damping>
        </dynamics>
      </axis>
    </joint>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>slider_joint</joint_name>
      <topic>/simulation/moving_obstacle/gz_target</topic>
      <p_gain>180.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>25.0</d_gain>
      <cmd_max>2000.0</cmd_max>
      <cmd_min>-2000.0</cmd_min>
    </plugin>
  </model>
</sdf>
