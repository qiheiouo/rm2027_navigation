FROM ros:humble-ros-base-jammy

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=rmnav
ARG USER_UID=1000
ARG USER_GID=1000
ARG LIVOX_SDK2_REPO=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_REF=master

SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    git \
    gnupg \
    libapr1-dev \
    libaprutil1-dev \
    libpcl-dev \
    lsb-release \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-vcstool \
    sudo \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-pcl-conversions \
    ros-humble-robot-state-publisher \
    ros-humble-rviz2 \
    ros-humble-nav2-rviz-plugins \
    ros-humble-tf2-tools \
    ros-humble-xacro \
  && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${LIVOX_SDK2_REF}" "${LIVOX_SDK2_REPO}" /tmp/Livox-SDK2 \
  && cmake -S /tmp/Livox-SDK2 -B /tmp/Livox-SDK2/build \
  && cmake --build /tmp/Livox-SDK2/build --parallel "$(nproc)" \
  && cmake --install /tmp/Livox-SDK2/build \
  && ldconfig \
  && rm -rf /tmp/Livox-SDK2

RUN if ! getent group "${USER_GID}" >/dev/null; then groupadd --gid "${USER_GID}" "${USERNAME}"; fi \
  && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home "${USERNAME}" \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
  && chmod 0440 "/etc/sudoers.d/${USERNAME}"

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi || true

COPY docker/entrypoint.sh /rm_nav_entrypoint.sh
RUN chmod +x /rm_nav_entrypoint.sh

USER "${USERNAME}"
WORKDIR /workspace/rm2027_navigation

RUN rosdep update || true

ENTRYPOINT ["/rm_nav_entrypoint.sh"]
CMD ["bash"]
